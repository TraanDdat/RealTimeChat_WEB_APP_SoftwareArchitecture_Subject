SYSTEM_VERSION=1
SECRET_KEY=your_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
PORT=8000
USER_SERVICE_URL=http://127.0.0.1:8000
REACT_APP_API_URL=http://localhost:5173,http://127.0.0.1:5173
AUTH=/api/auth
MESSAGE=/api/messages
USER_ADDFRIEND=/api/user/addfriend
GROUP=/api/groups
DB=./db
MONGODB_DATABASE=chat_db

# For local development, use AWS_PROFILE or AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY in .env.
# In AWS, prefer an IAM role. Never commit access keys or secret keys.
JWT_SECRET=replace-with-a-long-random-string
COOKIE_SECURE=false
REACT_APP_API_URL=http://localhost:5173

AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_access_key_here
AWS_REGION=ap-southeast-2
S3_BUCKET=s3-zalo
S3_PRESIGNED_URL_TTL_SECONDS=3600

MONGODB_URI=mongodb://user:password@mongodb_string
POSTGRES_DATABASE_URL=postgresql://username:password@localhost:5432/database_name
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name