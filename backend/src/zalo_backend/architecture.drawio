    <diagram id="zalo-authentication-flow" name="Authentication Flow">
        <mxGraphModel dx="1920" dy="902" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1250" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="auth_title" value="UIZalo Authentication Flow" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#1f2937;" parent="1" vertex="1">
                    <mxGeometry x="40" y="20" width="900" height="42" as="geometry"/>
                </mxCell>
                <mxCell id="web_lane" value="WEB CLIENT&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;React + Axios&lt;/font&gt;" style="swimlane;html=1;startSize=42;horizontal=1;rounded=0;fillColor=#dae8fc;swimlaneFillColor=#ffffff;strokeColor=#6c8ebf;fontSize=16;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="30" y="80" width="440" height="1080" as="geometry"/>
                </mxCell>
                <mxCell id="backend_lane" value="FASTAPI BACKEND&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;auth router + security + PostgreSQL&lt;/font&gt;" style="swimlane;html=1;startSize=42;horizontal=1;rounded=0;fillColor=#d5e8d4;swimlaneFillColor=#ffffff;strokeColor=#82b366;fontSize=16;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="580" y="80" width="440" height="1080" as="geometry"/>
                </mxCell>
                <mxCell id="android_lane" value="ANDROID CLIENT&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Retrofit + DataStore&lt;/font&gt;" style="swimlane;html=1;startSize=42;horizontal=1;rounded=0;fillColor=#fff2cc;swimlaneFillColor=#ffffff;strokeColor=#d6b656;fontSize=16;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="1130" y="80" width="440" height="1080" as="geometry"/>
                </mxCell>
                <mxCell id="web_login_request" value="1. Login request&lt;br&gt;&lt;b&gt;POST /api/auth/login&lt;/b&gt;&lt;br&gt;X-Client-Type: web&lt;br&gt;Axios withCredentials: true" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" parent="1" vertex="1">
                    <mxGeometry x="65" y="150" width="370" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="login_router" value="1. Auth endpoint&lt;br&gt;&lt;b&gt;routers/auth.py · login_request()&lt;/b&gt;&lt;br&gt;Reads email, password, X-Client-Type" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" parent="1" vertex="1">
                    <mxGeometry x="615" y="150" width="370" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="android_login_request" value="1. Login request&lt;br&gt;&lt;b&gt;POST /api/auth/login&lt;/b&gt;&lt;br&gt;X-Client-Type: android" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" parent="1" vertex="1">
                    <mxGeometry x="1175" y="150" width="350" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="credential_check" value="2. Verify credentials&lt;br&gt;&lt;b&gt;user_service.get_user(email)&lt;/b&gt;&lt;br&gt;&lt;b&gt;security.verify_password(... )&lt;/b&gt;&lt;br&gt;User lookup uses PostgreSQL session" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" parent="1" vertex="1">
                    <mxGeometry x="615" y="290" width="370" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="client_type_choice" value="3. Select token delivery&lt;br&gt;by X-Client-Type" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" parent="1" vertex="1">
                    <mxGeometry x="700" y="435" width="200" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="web_token_issue" value="Web branch&lt;br&gt;&lt;b&gt;set_auth_cookie(response, user_id)&lt;/b&gt;&lt;br&gt;Create JWT in HttpOnly cookie" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="605" y="585" width="180" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="android_token_issue" value="Android branch&lt;br&gt;&lt;b&gt;create_access_token(user_id)&lt;/b&gt;&lt;br&gt;Return JWT in JSON body" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="805" y="585" width="180" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="web_login_response" value="4. Login response&lt;br&gt;Set-Cookie: jwt=…; HttpOnly&lt;br&gt;data.access_token is null&lt;br&gt;Browser keeps cookie" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" parent="1" vertex="1">
                    <mxGeometry x="65" y="585" width="370" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="android_login_response" value="4. Login response&lt;br&gt;data.access_token = JWT&lt;br&gt;No auth cookie is set" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" parent="1" vertex="1">
                    <mxGeometry x="1175" y="585" width="350" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="web_protected_request" value="5. Confirm + later requests&lt;br&gt;Immediately GET /api/auth/check&lt;br&gt;Browser sends jwt cookie automatically&lt;br&gt;Socket.IO also uses cookie credentials" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" parent="1" vertex="1">
                    <mxGeometry x="65" y="735" width="370" height="105" as="geometry"/>
                </mxCell>
                <mxCell id="get_current_user" value="6. Authenticate protected REST request&lt;br&gt;&lt;b&gt;core/security.get_current_user()&lt;/b&gt;&lt;br&gt;Read Bearer header first, else jwt cookie&lt;br&gt;Decode token; invalid / missing token → 401" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" parent="1" vertex="1">
                    <mxGeometry x="615" y="735" width="370" height="105" as="geometry"/>
                </mxCell>
                <mxCell id="android_token_storage" value="5. Store + confirm session&lt;br&gt;&lt;b&gt;TokenManager → DataStore&lt;/b&gt;&lt;br&gt;Immediately GET /api/auth/check&lt;br&gt;OkHttp + Socket.IO send Bearer JWT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" parent="1" vertex="1">
                    <mxGeometry x="1175" y="735" width="350" height="105" as="geometry"/>
                </mxCell>
                <mxCell id="user_lookup" value="7. Resolve token subject&lt;br&gt;&lt;b&gt;user_service.get_user_by_id(db, user_id)&lt;/b&gt;&lt;br&gt;Load authenticated user from PostgreSQL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" parent="1" vertex="1">
                    <mxGeometry x="615" y="875" width="370" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="protected_endpoint" value="8. Continue to protected route&lt;br&gt;For example: GET /api/auth/check&lt;br&gt;Returns UserPublic; unknown user → 401" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" parent="1" vertex="1">
                    <mxGeometry x="615" y="1000" width="370" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="auth_error_note" value="Login failures&lt;br&gt;Unknown email → 404&lt;br&gt;Wrong password → 401&lt;br&gt;Invalid / expired session token → 401" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="65" y="885" width="370" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="logout_note" value="Logout behavior&lt;br&gt;Web: /api/auth/logout clears the jwt cookie.&lt;br&gt;Android: app clears DataStore locally; the backend does not revoke the JWT, so it remains valid until expiry if copied elsewhere." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="1175" y="885" width="350" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="socket_note" value="Socket.IO authentication is a separate backend path: socket/socketService.py reads the web jwt cookie or Android Bearer header and decodes it; socket/event.py then confirms the user through user_service/client.py." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="470" y="1120" width="680" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="auth_e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;" parent="1" source="web_login_request" target="login_router" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="auth_e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#d6b656;" parent="1" source="android_login_request" target="login_router" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="auth_e3" value="lookup + verify" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#82b366;fontSize=11;" parent="1" source="login_router" target="credential_check" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="auth_e4" value="valid credentials" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#82b366;fontSize=11;" parent="1" source="credential_check" target="client_type_choice" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="auth_e5" value="web" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;fontSize=11;" parent="1" source="client_type_choice" target="web_token_issue" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="auth_e6" value="android" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#d6b656;fontSize=11;" parent="1" source="client_type_choice" target="android_token_issue" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="auth_e7" value="Set-Cookie" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;fontSize=11;" parent="1" source="web_token_issue" target="web_login_response" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="auth_e8" value="JSON token" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#d6b656;fontSize=11;" parent="1" source="android_token_issue" target="android_login_response" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="auth_e9" value="cookie" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;fontSize=11;" parent="1" source="web_login_response" target="web_protected_request" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="auth_e10" value="saved JWT" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#d6b656;fontSize=11;" parent="1" source="android_login_response" target="android_token_storage" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="auth_e11" value="protected request" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;fontSize=11;" parent="1" source="web_protected_request" target="get_current_user" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="auth_e12" value="Authorization: Bearer" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#d6b656;fontSize=11;" parent="1" source="android_token_storage" target="get_current_user" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="auth_e13" value="valid subject id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontSize=11;" parent="1" source="get_current_user" target="user_lookup" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="auth_e14" value="user found" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#82b366;fontSize=11;" parent="1" source="user_lookup" target="protected_endpoint" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
            </root>
